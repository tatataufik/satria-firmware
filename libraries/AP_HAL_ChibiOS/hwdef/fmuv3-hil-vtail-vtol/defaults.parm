# Default parameters for fmuv3-hil-vtail-vtol (SITL-on-hardware with X-Plane backend)
# V-tail QuadPlane VTOL layout:
#   CH1=aileron, CH2=vtail_right, CH3=throttle (fwd pusher), CH4=vtail_left
#   CH5-CH8 = quad lift motors, H-frame (Q_FRAME_CLASS=1 Q_FRAME_TYPE=3)
# ArduPlane mixer produces physical vtail servo signals.

# ── EKF ──────────────────────────────────────────────────────────────────────
# EKF3 disabled — gyro not updating with EKF3 on fmuv3 (STM32F427).
AHRS_EKF_TYPE 2
EK2_ENABLE 1
EK3_ENABLE 0

# Compass: enabled — SITL compass backend reads from SIMState
COMPASS_USE 1
SIM_MAG1_OFS_X  5
SIM_MAG1_OFS_Y  13
SIM_MAG1_OFS_Z -18

# GPS: SITL GPS backend (type 100) — reads position/velocity from SIMState
GPS1_TYPE 100

# Airspeed: SITL backend (reads airspeed from SIMState / X-Plane)
ARSPD_TYPE 100

# Safety: no safety switch needed in simulation
BRD_SAFETY_DEFLT 0

# Arming: skip all pre-arm checks for simulation
ARMING_SKIPCHK -1
ARMING_REQUIRE 1

# RC: disable throttle failsafe and RC override timeout
THR_FAILSAFE 0
RC_OVERRIDE_TIME -1

# Scheduler: 50 Hz — prevents watchdog reset on STM32F427
SCHED_LOOP_RATE 50

# Logging: disabled — no SD card
LOG_BITMASK 0
LOG_BACKEND_TYPE 0
LOG_DISARM 0

# SITL speedup: 1x real-time
SIM_SPEEDUP 1

# ── INS filters ──────────────────────────────────────────────────────────────
INS_GYRO_FILTER  20
INS_ACCEL_FILTER 20

# ── Roll rate controller ──────────────────────────────────────────────────────
RLL_RATE_P       0.08
RLL_RATE_I       0.15
RLL_RATE_D       0
RLL_RATE_FF      0.345
RLL_RATE_FLTD    12
RLL_RATE_IMAX    0.666
RLL2SRV_TCONST   0.5
RLL2SRV_RMAX     0

# ── Pitch rate controller ─────────────────────────────────────────────────────
PTCH_RATE_P      0.04
PTCH_RATE_I      0.15
PTCH_RATE_D      0
PTCH_RATE_FF     0.345
PTCH_RATE_FLTD   12
PTCH_RATE_IMAX   0.666
PTCH2SRV_TCONST  0.5
PTCH2SRV_RMAX_UP 0
PTCH2SRV_RMAX_DN 0
PTCH2SRV_RLL     1

# ── Flight envelope ───────────────────────────────────────────────────────────
AIRSPEED_CRUISE   12
AIRSPEED_MIN       9
AIRSPEED_MAX      22
TRIM_THROTTLE     45
PTCH_LIM_MIN_DEG -25
PTCH_LIM_MAX_DEG  20
ROLL_LIMIT_DEG    45

# ── Navigation ────────────────────────────────────────────────────────────────
NAVL1_PERIOD   17
NAVL1_DAMPING  0.75
KFF_RDDRMIX    0.5

# ── Servo output functions — fixed-wing surfaces + forward throttle ──────────
# ArduPlane's channel_function_mixer runs automatically when vtail_right and
# vtail_left functions are assigned:
#   vtail_right (CH2) = (elevator - rudder) * MIXING_GAIN
#   vtail_left  (CH4) = (elevator + rudder) * MIXING_GAIN
SERVO1_FUNCTION 4    # Aileron
SERVO2_FUNCTION 80   # Vtail_right  (elevator - rudder)
SERVO2_REVERSED 1
SERVO3_FUNCTION 70   # Throttle (forward pusher)
SERVO4_FUNCTION 79   # Vtail_left   (elevator + rudder)
SERVO4_REVERSED 1

# ── Servo output functions — quad lift motors (QuadPlane H-frame) ────────────
# Q_FRAME_TYPE=3 (H-frame) channel order:
#   Motor1 = front-right CW   Motor2 = rear-left  CW
#   Motor3 = front-left CCW   Motor4 = rear-right CCW
SERVO5_FUNCTION 33   # Motor1
SERVO6_FUNCTION 34   # Motor2
SERVO7_FUNCTION 35   # Motor3
SERVO8_FUNCTION 36   # Motor4

# MIXING_GAIN 1.0: full servo travel for full stick input.
MIXING_GAIN 1.0

# ── RC input channel mapping ──────────────────────────────────────────────────
RCMAP_ROLL      1
RCMAP_PITCH     2
RCMAP_THROTTLE  3
RCMAP_YAW       4

# ── QuadPlane VTOL ────────────────────────────────────────────────────────────
# Enable QuadPlane with H-frame motor layout matching xplane_vtail_vtol.json.
Q_ENABLE        1
Q_FRAME_CLASS   1    # Quad
Q_FRAME_TYPE    3    # H-frame
Q_M_PWM_MIN     1000
Q_M_PWM_MAX     2000
Q_M_SPIN_MIN    0.15
Q_M_SPIN_ARM    0.10

# Hover & transition tuning (conservative defaults; tune per airframe)
Q_THR_HOVER     0.5
Q_TRANSITION_MS 5000
Q_ASSIST_SPEED  10
Q_ASSIST_ANGLE  30

# Quad attitude / rate (conservative starting gains)
Q_A_RAT_RLL_P   0.135
Q_A_RAT_RLL_I   0.135
Q_A_RAT_RLL_D   0.0036
Q_A_RAT_PIT_P   0.135
Q_A_RAT_PIT_I   0.135
Q_A_RAT_PIT_D   0.0036
Q_A_RAT_YAW_P   0.18
Q_A_RAT_YAW_I   0.018

# ── Auto takeoff — ground roll + steering (forward-flight only) ──────────────
TKOFF_THR_MINACC 0
TKOFF_THR_MINSPD 0
TKOFF_THR_DELAY  0
TKOFF_THR_MAX    100
TKOFF_ROTATE_SPD 12
GROUND_STEER_ALT 5
TKOFF_TDRAG_ELEV 0
TKOFF_TDRAG_SPD1 0

# ── SITL servo override ───────────────────────────────────────────────────────
SIM_OH_MASK 255

# ── X-Plane UDP bind port ────────────────────────────────────────────────────
# Configure X-Plane Net Connections → Data: send DATA@ to 10.0.0.2:49005
SIM_XP_BIND_PORT 49005

# ── SITL home position — Bandung WICC ────────────────────────────────────────
SIM_OPOS_LAT -6.897434
SIM_OPOS_LNG  107.566887
SIM_OPOS_ALT  744.0
SIM_OPOS_HDG  108.0

# ── Tracking target position ──────────────────────────────────────────────────
TRK_TGT_LAT -6.897367724
TRK_TGT_LON  107.566559898
TRK_TGT_ALT  744.0

# ── Networking / PPP ─────────────────────────────────────────────────────────
# USB (SERIAL0) stays as MAVLink2 — QGC connects directly via USB.
# PPP runs on TELEM2 (SERIAL2) for X-Plane UDP data.
# PC command (macOS): sudo pppd /dev/tty.usbserial-XXXX 115200 10.0.0.1:10.0.0.2 noauth local nodetach asyncmap 0 novj nopcomp noaccomp lcp-echo-interval 0
# PC command (Linux): sudo pppd /dev/ttyUSB0 115200 10.0.0.1:10.0.0.2 noauth local nodetach asyncmap 0 novj nopcomp noaccomp lcp-echo-interval 0
SERIAL0_PROTOCOL 2
SERIAL0_BAUD 921

NET_ENABLE 1
SERIAL2_PROTOCOL 48
SERIAL2_BAUD 115

NET_IPADDR0 10
NET_IPADDR1 0
NET_IPADDR2 0
NET_IPADDR3 2

# NET_OPTIONS bit 6 (64) = PPP_ECHO_LIMIT_DISABLE
NET_OPTIONS 64
